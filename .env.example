# Supabase project credentials (found in Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the browser
# Used by Server Actions to call generate_daily_tasks() and other SECURITY DEFINER functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API — server-side only, never expose to the browser
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Login page email mapping — must match the email addresses you created in Supabase Auth
NEXT_PUBLIC_ADMIN_EMAIL=dee@craftsmanacademy.app
NEXT_PUBLIC_DEVEN_EMAIL=deven@craftsmanacademy.app
NEXT_PUBLIC_SHAAN_EMAIL=shaan@craftsmanacademy.app
