# ── Supabase ───────────────────────────────────────────────────────────────────
# Found in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the browser
# Used by Server Actions that require elevated DB access
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── School identity ────────────────────────────────────────────────────────────
# Appears in the browser tab title, sidebar logo, and login page footer
NEXT_PUBLIC_SCHOOL_NAME=Craftsman Academy

# ── Admin (instructor/parent) login profile ────────────────────────────────────
# Must match the email you created in Supabase Auth for the admin user
NEXT_PUBLIC_ADMIN_EMAIL=parent@example.com
NEXT_PUBLIC_ADMIN_NAME=Mom
NEXT_PUBLIC_ADMIN_TAGLINE=Instructor

# ── Student login profiles ─────────────────────────────────────────────────────
# Must match emails you created in Supabase Auth for each student
# Profiles with an empty email are hidden from the login screen automatically
NEXT_PUBLIC_STUDENT1_EMAIL=student1@example.com
NEXT_PUBLIC_STUDENT1_NAME=Student One
NEXT_PUBLIC_STUDENT1_TAGLINE=

NEXT_PUBLIC_STUDENT2_EMAIL=student2@example.com
NEXT_PUBLIC_STUDENT2_NAME=Student Two
NEXT_PUBLIC_STUDENT2_TAGLINE=

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Server-side only. Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Calendar ───────────────────────────────────────────────────────────────────
# Paste a webcal:// or https:// .ics URL here
# Google Calendar: Calendar Settings → "Secret address in iCal format"
# Apple Calendar: share any calendar → copy the webcal link
CALENDAR_ICAL_URL=your-ical-url
